# Required application configuration
DATABASE_URL=postgresql://whatsapp_app:replace-with-your-password@localhost:5432/whatsapp_automation
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4111
DASHBOARD_URL=http://localhost:5173

# Optional server configuration
# PORT=4111

# Test-only database. It must not point to the development database.
TEST_DATABASE_URL=postgresql://whatsapp_app:replace-with-your-password@localhost:5432/whatsapp_automation_test

# Optional existing Mastra storage override
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# Meta WhatsApp Cloud API configuration.
# Only the verification token is required for the current GET webhook handshake.
META_WHATSAPP_API_VERSION=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
# Required for GET /webhooks/whatsapp verification.
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
