generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum BusinessLifecycleStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("business_lifecycle_status")
}

enum BusinessUserRole {
  OWNER
  STAFF

  @@map("business_user_role")
}

enum BusinessFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTI_SELECT

  @@map("business_field_type")
}

enum BusinessEntityStatus {
  ACTIVE
  ARCHIVED

  @@map("business_entity_status")
}

enum DataSource {
  MANUAL
  IMPORT
  API
  SYNC
  SYSTEM

  @@map("data_source")
}

enum FreshnessClass {
  STABLE
  CHANGING
  REAL_TIME

  @@map("freshness_class")
}

enum AuditActorKind {
  USER
  SYSTEM
  INTEGRATION

  @@map("audit_actor_kind")
}

enum AuditTargetType {
  BUSINESS_PROFILE
  OPENING_HOURS
  BUSINESS_RULE
  BUSINESS_ENTITY_TYPE
  BUSINESS_FIELD_DEFINITION
  BUSINESS_ENTITY
  CONVERSATION
  LEAD
  CUSTOMER

  @@map("audit_target_type")
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  SCHEMA_CHANGE
  VERIFY
  MODE_CHANGE
  STATUS_CHANGE

  @@map("audit_action")
}

enum BusinessWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("business_weekday")
}

enum ConversationChannel {
  DASHBOARD
  WHATSAPP

  @@map("conversation_channel")
}

enum ConversationMode {
  AI
  HUMAN
  PAUSED

  @@map("conversation_mode")
}

enum ConversationStatus {
  OPEN
  CLOSED

  @@map("conversation_status")
}

enum ConversationHandoffReason {
  CUSTOMER_REQUEST
  LOW_CONFIDENCE
  PURCHASE_INTENT
  COMPLAINT
  MANUAL

  @@map("conversation_handoff_reason")
}

enum ConversationMessageDirection {
  INBOUND
  OUTBOUND

  @@map("conversation_message_direction")
}

enum ConversationMessageSenderType {
  CUSTOMER
  AI
  HUMAN
  SYSTEM

  @@map("conversation_message_sender_type")
}

enum WhatsAppConnectionStatus {
  ACTIVE
  INACTIVE

  @@map("whatsapp_connection_status")
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND

  @@map("whatsapp_message_direction")
}

enum WhatsAppInboundProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("whatsapp_inbound_processing_status")
}

enum WhatsAppDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("whatsapp_delivery_status")
}

enum LeadStatus {
  NEW
  INTERESTED
  QUALIFIED
  WON
  LOST

  @@map("lead_status")
}

enum LeadIntent {
  INFORMATION
  PURCHASE_INTEREST
  BOOKING_INTEREST
  COMPLAINT
  SUPPORT

  @@map("lead_intent")
}

enum LeadStatusSource {
  AUTOMATIC
  MANUAL

  @@map("lead_status_source")
}

enum LeadEvidenceType {
  PURCHASE_INTENT
  BOOKING_INTENT
  ITEM_OR_SERVICE
  DATE_OR_TIME
  BUDGET
  QUANTITY_OR_DURATION
  COMMITMENT

  @@map("lead_evidence_type")
}

enum FollowUpStatus {
  PENDING
  PROCESSING
  SENDING
  SENT
  CANCELLED
  FAILED

  @@map("follow_up_status")
}

enum FollowUpType {
  INITIAL

  @@map("follow_up_type")
}

model Business {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String                  @db.Text
  category                       String                  @db.Text
  description                    String?                 @db.Text
  phone                          String?                 @db.Text
  address                        String?                 @db.Text
  timezone                       String                  @db.Text
  followUpsEnabled               Boolean                 @default(false) @map("follow_ups_enabled")
  initialFollowUpDelayMinutes    Int                     @default(60) @map("initial_follow_up_delay_minutes")
  followUpWindowStartMinutes     Int                     @default(540) @map("follow_up_window_start_minutes")
  followUpWindowEndMinutes       Int                     @default(1200) @map("follow_up_window_end_minutes")
  maxFollowUpsPerLead            Int                     @default(1) @map("max_follow_ups_per_lead")
  minimumFollowUpIntervalMinutes Int                     @default(1440) @map("minimum_follow_up_interval_minutes")
  currency                       String                  @db.VarChar(3)
  defaultLanguage                String                  @map("default_language") @db.Text
  supportedLanguages             String[]                @default([]) @map("supported_languages")
  lifecycleStatus                BusinessLifecycleStatus @map("lifecycle_status")
  profileSource                  DataSource              @default(MANUAL) @map("profile_source")
  profileExternalId              String?                 @map("profile_external_id") @db.Text
  profileLastVerifiedAt          DateTime?               @map("profile_last_verified_at") @db.Timestamptz(6)
  profileFreshnessClass          FreshnessClass          @default(STABLE) @map("profile_freshness_class")
  profileStaleAfterSeconds       Int?                    @map("profile_stale_after_seconds")
  createdAt                      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                    BusinessUser[]
  entityTypes                    BusinessEntityType[]
  entities                       BusinessEntity[]
  openingHours                   BusinessOpeningHour[]
  rules                          BusinessRule[]
  auditEvents                    AuditEvent[]
  conversations                  Conversation[]
  conversationMessages           ConversationMessage[]
  whatsappConnections            WhatsAppConnection[]
  customers                      Customer[]
  whatsappMessages               WhatsAppMessage[]
  leads                          Lead[]
  leadEvidence                   LeadEvidence[]
  followUps                      FollowUp[]

  @@map("businesses")
}

model WhatsAppConnection {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                String                   @map("business_id") @db.Uuid
  phoneNumberId             String                   @unique(map: "whatsapp_connections_phone_number_id_unique") @map("phone_number_id") @db.VarChar(100)
  whatsappBusinessAccountId String                   @map("whatsapp_business_account_id") @db.VarChar(100)
  displayPhoneNumber        String?                  @map("display_phone_number") @db.Text
  status                    WhatsAppConnectionStatus @default(ACTIVE)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business                  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages                  WhatsAppMessage[]
  conversations             Conversation[]

  @@unique([businessId, id], map: "whatsapp_connections_business_id_id_unique")
  @@index([businessId, status], map: "whatsapp_connections_business_id_status_index")
  @@map("whatsapp_connections")
}

model Customer {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                  String            @map("business_id") @db.Uuid
  whatsappPhone               String            @map("whatsapp_phone") @db.VarChar(100)
  followUpConsentAt           DateTime?         @map("follow_up_consent_at") @db.Timestamptz(6)
  followUpOptedOutAt          DateTime?         @map("follow_up_opted_out_at") @db.Timestamptz(6)
  followUpConsentRecordedById String?           @map("follow_up_consent_recorded_by_id") @db.Uuid
  createdAt                   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business                    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages                    WhatsAppMessage[]
  conversations               Conversation[]
  leads                       Lead[]
  followUps                   FollowUp[]

  @@unique([businessId, id], map: "customers_business_id_id_unique")
  @@unique([businessId, whatsappPhone], map: "customers_business_id_whatsapp_phone_unique")
  @@map("customers")
}

model WhatsAppMessage {
  id                    String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String                           @map("business_id") @db.Uuid
  whatsappConnectionId  String                           @map("whatsapp_connection_id") @db.Uuid
  customerId            String                           @map("customer_id") @db.Uuid
  conversationMessageId String?                          @map("conversation_message_id") @db.Uuid
  direction             WhatsAppMessageDirection
  externalMessageId     String?                          @unique(map: "whatsapp_messages_external_message_id_unique") @map("external_message_id") @db.Text
  recipientPhone        String?                          @map("recipient_phone") @db.VarChar(100)
  processingStatus      WhatsAppInboundProcessingStatus? @map("processing_status")
  deliveryStatus        WhatsAppDeliveryStatus?          @map("delivery_status")
  providerTimestamp     DateTime?                        @map("provider_timestamp") @db.Timestamptz(6)
  processingStartedAt   DateTime?                        @map("processing_started_at") @db.Timestamptz(6)
  processedAt           DateTime?                        @map("processed_at") @db.Timestamptz(6)
  processingFailedAt    DateTime?                        @map("processing_failed_at") @db.Timestamptz(6)
  sentAt                DateTime?                        @map("sent_at") @db.Timestamptz(6)
  deliveredAt           DateTime?                        @map("delivered_at") @db.Timestamptz(6)
  readAt                DateTime?                        @map("read_at") @db.Timestamptz(6)
  failedAt              DateTime?                        @map("failed_at") @db.Timestamptz(6)
  failureCode           String?                          @map("failure_code") @db.VarChar(100)
  failureTitle          String?                          @map("failure_title") @db.Text
  failureDetails        String?                          @map("failure_details") @db.Text
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business              Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  whatsappConnection    WhatsAppConnection               @relation(fields: [businessId, whatsappConnectionId], references: [businessId, id], onDelete: Cascade)
  customer              Customer                         @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  conversationMessage   ConversationMessage?             @relation(fields: [businessId, conversationMessageId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, conversationMessageId], map: "whatsapp_messages_business_conversation_message_unique")
  @@index([businessId, direction, createdAt], map: "whatsapp_messages_business_direction_created_index")
  @@index([businessId, deliveryStatus], map: "whatsapp_messages_business_delivery_status_index")
  @@map("whatsapp_messages")
}

model Conversation {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String                     @map("business_id") @db.Uuid
  customerId             String?                    @map("customer_id") @db.Uuid
  whatsappConnectionId   String?                    @map("whatsapp_connection_id") @db.Uuid
  channel                ConversationChannel
  participantKey         String                     @map("participant_key") @db.Text
  mode                   ConversationMode           @default(AI)
  status                 ConversationStatus         @default(OPEN)
  assignedBusinessUserId String?                    @map("assigned_business_user_id") @db.Uuid
  handoffReason          ConversationHandoffReason? @map("handoff_reason")
  controlVersion         Int                        @default(0) @map("control_version")
  pendingActions         Json                       @default("[]") @map("pending_actions") @db.JsonB
  messageCount           Int                        @default(0) @map("message_count")
  lastActivityAt         DateTime                   @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business               Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer               Customer?                  @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  whatsappConnection     WhatsAppConnection?        @relation(fields: [businessId, whatsappConnectionId], references: [businessId, id], onDelete: Restrict)
  assignedBusinessUser   BusinessUser?              @relation("ConversationAssignment", fields: [businessId, assignedBusinessUserId], references: [businessId, id], onDelete: Restrict)
  messages               ConversationMessage[]
  leads                  Lead[]
  followUps              FollowUp[]

  @@unique([businessId, id], map: "conversations_business_id_id_unique")
  @@unique([businessId, id, customerId], map: "conversations_business_id_customer_id_unique")
  @@unique([businessId, channel, participantKey], map: "conversations_business_channel_participant_unique")
  @@unique([businessId, channel, customerId], map: "conversations_business_channel_customer_unique")
  @@index([businessId, lastActivityAt(sort: Desc)], map: "conversations_business_last_activity_index")
  @@index([businessId, mode, status, lastActivityAt(sort: Desc)], map: "conversations_business_mode_status_activity_index")
  @@index([businessId, assignedBusinessUserId, lastActivityAt(sort: Desc)], map: "conversations_business_assignment_activity_index")
  @@map("conversations")
}

model ConversationMessage {
  id                   String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String                        @map("business_id") @db.Uuid
  conversationId       String                        @map("conversation_id") @db.Uuid
  sequence             Int
  direction            ConversationMessageDirection
  senderType           ConversationMessageSenderType @map("sender_type")
  sentByBusinessUserId String?                       @map("sent_by_business_user_id") @db.Uuid
  content              String                        @db.Text
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  business             Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation         Conversation                  @relation(fields: [businessId, conversationId], references: [businessId, id], onDelete: Cascade)
  sentByBusinessUser   BusinessUser?                 @relation("HumanMessageSender", fields: [businessId, sentByBusinessUserId], references: [businessId, id], onDelete: Restrict)
  whatsappMessage      WhatsAppMessage?
  leadEvidence         LeadEvidence[]
  followUp             FollowUp?

  @@unique([businessId, id], map: "conversation_messages_business_id_id_unique")
  @@unique([businessId, conversationId, id], map: "conversation_messages_business_conversation_id_unique")
  @@unique([businessId, conversationId, sequence], map: "conversation_messages_business_conversation_sequence_unique")
  @@index([businessId, conversationId, createdAt], map: "conversation_messages_business_conversation_created_index")
  @@map("conversation_messages")
}

model Lead {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  customerId       String           @map("customer_id") @db.Uuid
  conversationId   String           @map("conversation_id") @db.Uuid
  status           LeadStatus       @default(NEW)
  intent           LeadIntent
  statusSource     LeadStatusSource @default(AUTOMATIC) @map("status_source")
  summary          String?          @db.Text
  summaryDetails   Json?            @map("summary_details") @db.JsonB
  summaryUpdatedAt DateTime?        @map("summary_updated_at") @db.Timestamptz(6)
  statusUpdatedAt  DateTime         @default(now()) @map("status_updated_at") @db.Timestamptz(6)
  lastActivityAt   DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer         @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  conversation     Conversation     @relation(fields: [businessId, conversationId, customerId], references: [businessId, id, customerId], onDelete: Restrict)
  evidence         LeadEvidence[]
  followUps        FollowUp[]

  @@unique([businessId, id], map: "leads_business_id_id_unique")
  @@unique([businessId, id, conversationId], map: "leads_business_id_conversation_id_unique")
  @@index([businessId, status, lastActivityAt(sort: Desc)], map: "leads_business_status_activity_index")
  @@index([businessId, customerId, lastActivityAt(sort: Desc)], map: "leads_business_customer_activity_index")
  @@index([businessId, conversationId], map: "leads_business_conversation_index")
  @@map("leads")
}

model FollowUp {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String               @map("business_id") @db.Uuid
  leadId                String               @map("lead_id") @db.Uuid
  conversationId        String               @map("conversation_id") @db.Uuid
  customerId            String               @map("customer_id") @db.Uuid
  conversationMessageId String?              @unique(map: "follow_ups_conversation_message_unique") @map("conversation_message_id") @db.Uuid
  type                  FollowUpType         @default(INITIAL)
  status                FollowUpStatus       @default(PENDING)
  content               String               @db.Text
  scheduledAt           DateTime             @map("scheduled_at") @db.Timestamptz(6)
  customerActivityAt    DateTime             @map("customer_activity_at") @db.Timestamptz(6)
  attemptCount          Int                  @default(0) @map("attempt_count")
  lastAttemptAt         DateTime?            @map("last_attempt_at") @db.Timestamptz(6)
  claimedAt             DateTime?            @map("claimed_at") @db.Timestamptz(6)
  sentAt                DateTime?            @map("sent_at") @db.Timestamptz(6)
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  failedAt              DateTime?            @map("failed_at") @db.Timestamptz(6)
  reasonCode            String?              @map("reason_code") @db.VarChar(80)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead                  Lead                 @relation(fields: [businessId, leadId, conversationId], references: [businessId, id, conversationId], onDelete: Cascade, map: "follow_ups_business_lead_conversation_fkey")
  conversation          Conversation         @relation(fields: [businessId, conversationId, customerId], references: [businessId, id, customerId], onDelete: Cascade, map: "follow_ups_business_conversation_customer_fkey")
  customer              Customer             @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade, map: "follow_ups_business_customer_fkey")
  conversationMessage   ConversationMessage? @relation(fields: [businessId, conversationId, conversationMessageId], references: [businessId, conversationId, id], onDelete: Restrict, map: "follow_ups_business_conversation_message_fkey")

  @@unique([businessId, id], map: "follow_ups_business_id_id_unique")
  @@unique([businessId, conversationId, conversationMessageId], map: "follow_ups_business_conversation_message_unique")
  @@index([status, scheduledAt], map: "follow_ups_status_scheduled_at_index")
  @@index([businessId, customerId, sentAt], map: "follow_ups_business_customer_sent_index")
  @@index([businessId, leadId, createdAt], map: "follow_ups_business_lead_created_index")
  @@map("follow_ups")
}

model LeadEvidence {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String              @map("business_id") @db.Uuid
  leadId         String              @map("lead_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  messageId      String              @map("message_id") @db.Uuid
  evidenceTypes  LeadEvidenceType[]  @map("evidence_types")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead           Lead                @relation(fields: [businessId, leadId, conversationId], references: [businessId, id, conversationId], onDelete: Cascade)
  message        ConversationMessage @relation(fields: [businessId, conversationId, messageId], references: [businessId, conversationId, id], onDelete: Restrict)

  @@unique([businessId, leadId, messageId], map: "lead_evidence_business_lead_message_unique")
  @@index([businessId, leadId, createdAt], map: "lead_evidence_business_lead_created_index")
  @@index([businessId, conversationId, messageId], map: "lead_evidence_business_conversation_message_index")
  @@map("lead_evidence")
}

model BusinessOpeningHour {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  dayOfWeek         BusinessWeekday @map("day_of_week")
  isOpen            Boolean         @default(false) @map("is_open")
  opensAt           String?         @map("opens_at") @db.VarChar(5)
  closesAt          String?         @map("closes_at") @db.VarChar(5)
  source            DataSource      @default(MANUAL)
  externalId        String?         @map("external_id") @db.Text
  lastVerifiedAt    DateTime?       @map("last_verified_at") @db.Timestamptz(6)
  freshnessClass    FreshnessClass  @default(CHANGING) @map("freshness_class")
  staleAfterSeconds Int?            @map("stale_after_seconds")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek], map: "business_opening_hours_business_id_day_unique")
  @@map("business_opening_hours")
}

model BusinessRule {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String         @map("business_id") @db.Uuid
  category          String         @db.Text
  name              String         @db.Text
  content           String         @db.Text
  active            Boolean        @default(true)
  source            DataSource     @default(MANUAL)
  externalId        String?        @map("external_id") @db.Text
  lastVerifiedAt    DateTime?      @map("last_verified_at") @db.Timestamptz(6)
  freshnessClass    FreshnessClass @default(STABLE) @map("freshness_class")
  staleAfterSeconds Int?           @map("stale_after_seconds")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active], map: "business_rules_business_id_active_index")
  @@map("business_rules")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @db.Text
  email         String         @unique(map: "users_email_unique") @db.Text
  emailVerified Boolean        @default(false) @map("email_verified")
  image         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]
  memberships   BusinessUser[]
  auditEvents   AuditEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique(map: "sessions_token_unique") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_index")
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id") @db.Text
  providerId            String    @map("provider_id") @db.Text
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "accounts_user_id_index")
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "verifications_identifier_index")
  @@map("verifications")
}

model BusinessUser {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String                @map("user_id") @db.Uuid
  businessId               String                @map("business_id") @db.Uuid
  role                     BusinessUserRole
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  business                 Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedConversations    Conversation[]        @relation("ConversationAssignment")
  sentConversationMessages ConversationMessage[] @relation("HumanMessageSender")

  @@unique([userId, businessId], map: "business_users_user_id_business_id_unique")
  @@unique([businessId, id], map: "business_users_business_id_id_unique")
  @@index([businessId], map: "business_users_business_id_index")
  @@map("business_users")
}

model BusinessEntityType {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String                    @map("business_id") @db.Uuid
  key              String                    @db.Text
  name             String                    @db.Text
  description      String?                   @db.Text
  schemaVersion    Int                       @default(1) @map("schema_version")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fieldDefinitions BusinessFieldDefinition[]
  entities         BusinessEntity[]

  @@unique([businessId, key], map: "business_entity_types_business_id_key_unique")
  @@unique([businessId, id], map: "business_entity_types_business_id_id_unique")
  @@map("business_entity_types")
}

model BusinessFieldDefinition {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityTypeId      String             @map("entity_type_id") @db.Uuid
  key               String             @db.Text
  label             String             @db.Text
  type              BusinessFieldType
  required          Boolean            @default(false)
  enabled           Boolean            @default(true)
  options           Json?              @db.JsonB
  displayOrder      Int                @map("display_order")
  freshnessClass    FreshnessClass     @default(CHANGING) @map("freshness_class")
  staleAfterSeconds Int?               @map("stale_after_seconds")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  entityType        BusinessEntityType @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)

  @@unique([entityTypeId, key], map: "business_field_definitions_entity_type_id_key_unique")
  @@map("business_field_definitions")
}

model BusinessEntity {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  entityTypeId   String               @map("entity_type_id") @db.Uuid
  name           String               @db.Text
  data           Json                 @db.JsonB
  status         BusinessEntityStatus @default(ACTIVE)
  source         DataSource           @default(MANUAL)
  externalId     String?              @map("external_id") @db.Text
  lastVerifiedAt DateTime?            @map("last_verified_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entityType     BusinessEntityType   @relation(fields: [businessId, entityTypeId], references: [businessId, id], onDelete: Cascade)

  @@index([entityTypeId], map: "business_entities_entity_type_id_index")
  @@index([businessId, entityTypeId, status], map: "business_entities_business_id_entity_type_id_status_index")
  @@index([data(ops: JsonbPathOps)], type: Gin, map: "business_entities_data_gin_index")
  @@map("business_entities")
}

model AuditEvent {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String          @map("business_id") @db.Uuid
  actorUserId String?         @map("actor_user_id") @db.Uuid
  actorKind   AuditActorKind  @map("actor_kind")
  targetType  AuditTargetType @map("target_type")
  targetId    String          @map("target_id") @db.Uuid
  action      AuditAction
  before      Json?           @db.JsonB
  after       Json?           @db.JsonB
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorUser   User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt], map: "audit_events_business_id_created_at_index")
  @@index([businessId, targetType, targetId, createdAt], map: "audit_events_business_target_created_at_index")
  @@map("audit_events")
}
