{
  "name": "server",
  "version": "1.0.0",
  "description": "Mastra application server for the multi-tenant WhatsApp automation platform.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx scripts/run-tests.ts",
    "test:run": "vitest run",
    "db:connect": "tsx src/db/check-connection.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "build": "mastra build",
    "start": "mastra start"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/auth-better-auth": "^1.1.4",
    "@mastra/core": "1.61.0",
    "@mastra/duckdb": "1.6.2",
    "@mastra/libsql": "1.21.1",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "1.27.0",
    "@mastra/observability": "1.17.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.23",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.26.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
