{
  "name": "server",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "typecheck": "tsc --noEmit --pretty false",
    "db:connect": "tsx src/db/check-connection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "build": "mastra build",
    "start": "mastra start"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@mastra/duckdb": "1.6.2",
    "@mastra/libsql": "1.21.1",
    "@mastra/memory": "1.27.0",
    "@mastra/observability": "1.17.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "mastra": "1.26.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
