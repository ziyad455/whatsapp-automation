{
  "name": "whatsapp-automation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names dashboard,server \"npm run dev:dashboard\" \"npm run dev:server\"",
    "dev:dashboard": "npm run dev --prefix dashboard",
    "dev:server": "npm run dev --prefix server",
    "test": "npm run test --prefix server"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@mastra/evals": "^1.10.0",
    "@mastra/memory": "^1.28.2",
    "@mastra/observability": "^1.17.5"
  }
}
